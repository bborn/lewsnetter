<% page_title = "Sequences" %>
<% content_for :page_title, page_title %>
<% th = "px-6 py-3 font-mono text-[11px] uppercase tracking-[0.06em] text-zinc-500 dark:text-zinc-400 font-normal" %>
<% num = "px-6 py-3.5 font-mono text-[13px] tabular-nums text-right text-zinc-700 dark:text-zinc-300" %>

<div class="max-w-[1120px] mx-auto px-8 pt-14 pb-24">

  <header class="mb-8 flex items-baseline justify-between gap-6">
    <div>
      <div class="font-mono text-[11px] uppercase tracking-[0.06em] text-zinc-500 dark:text-zinc-400 mb-2">Automation</div>
      <h1 class="text-[32px] font-semibold tracking-[-0.02em] text-zinc-900 dark:text-zinc-50 leading-tight"><%= page_title %></h1>
    </div>
    <%= link_to "New sequence", new_account_team_sequence_path(@team),
          class: "px-4 py-2 rounded-md bg-orange-600 hover:bg-orange-700 text-white text-[14px] font-medium transition-colors" %>
  </header>

  <% if @sequences.any? %>
    <section class="rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden bg-white dark:bg-zinc-900">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950">
            <th class="<%= th %>">Name</th>
            <th class="<%= th %>">Trigger</th>
            <th class="<%= th %>">Status</th>
            <th class="<%= th %> text-right">Steps</th>
            <th class="<%= th %> text-right">Active</th>
            <th class="<%= th %> text-right">Completed</th>
            <th class="<%= th %> text-right">Exited</th>
          </tr>
        </thead>
        <tbody>
          <% @sequences.each do |sequence| %>
            <% counts = ->(state) { @enrollment_counts.fetch([sequence.id, state], 0) } %>
            <tr class="border-b border-zinc-100 dark:border-zinc-800/70 last:border-0 hover:bg-zinc-50/60 dark:hover:bg-zinc-950/40">
              <td class="px-6 py-3.5 text-[14px] font-medium">
                <%= link_to sequence.name, account_sequence_path(sequence), class: "text-zinc-900 dark:text-zinc-100 hover:text-orange-600 dark:hover:text-orange-400" %>
              </td>
              <td class="px-6 py-3.5 font-mono text-[12px] text-zinc-500 dark:text-zinc-400">
                <%= render "account/sequences/trigger_label", sequence: sequence %>
              </td>
              <td class="px-6 py-3.5"><%= render "account/sequences/status_pill", status: sequence.status %></td>
              <td class="<%= num %>"><%= sequence.steps.size %></td>
              <td class="<%= num %>"><%= number_with_delimiter(counts.("active")) %></td>
              <td class="<%= num %>"><%= number_with_delimiter(counts.("completed")) %></td>
              <td class="<%= num %>"><%= number_with_delimiter(counts.("exited") + counts.("suppressed")) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% else %>
    <div class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-center py-16 px-6">
      <div class="font-mono text-[11px] uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-2">No sequences</div>
      <%= link_to "New sequence →", new_account_team_sequence_path(@team), class: "button" %>
    </div>
  <% end %>

</div>
